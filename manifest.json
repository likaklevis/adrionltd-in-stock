{
    "manifest_version": 3,
    "name": "Adrionltd In-Stock Filter",
    "version": "1.0.1",
    "author": "KLIKA",
    "description": "Automatically keeps the in-stock filter enabled on adrionltd.com.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "adrionltd-in-stock@klika",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://adrionltd.com/*",
                "*://www.adrionltd.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
